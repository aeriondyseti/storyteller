{
  "name": "storyteller",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Roleplay and collaborative storytelling inside the Claude Code TUI",
  "bin": {
    "rp": "bin/rp.ts"
  },
  "scripts": {
    "rp": "bun bin/rp.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "verify": "bun run typecheck && bun run lint && bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "sqlite-vec": "^0.1.9",
    "zod": "^4.6.5"
  }
}
